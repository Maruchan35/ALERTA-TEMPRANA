# Secretos de las Edge Functions de ALERTA CERCA.
#
# En la nube se configuran con:   supabase secrets set --env-file supabase/functions/.env
# En local (supabase functions serve) se leen de supabase/functions/.env
# Copia este archivo como .env y llena los valores. El .env está en .gitignore: NUNCA lo subas.
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya existen por defecto en las Edge Functions.

# Cadena larga y aleatoria. La misma que guardas en Vault como 'secreto_funciones'
SECRETO_FUNCIONES=

# JSON COMPLETO de la cuenta de servicio de Firebase (Configuración → Cuentas de servicio →
# Generar nueva clave privada), en UNA sola línea. Sin esto no se envían notificaciones push.
FIREBASE_SERVICE_ACCOUNT=

# Token del bot que te dio @BotFather (opcional: canal alterno por Telegram)
TELEGRAM_BOT_TOKEN=

# Cadena aleatoria que Telegram enviará en cada webhook (la registras con setWebhook)
TELEGRAM_SECRETO=

# Identificador del emisor en el feed CAP (opcional)
CAP_EMISOR=alertacerca

# WhatsApp de verdad para el código de verificación (opcional). Mientras falten, la verificación
# usa WhatsApp SIMULADO (config.whatsapp_simulado = true). Ver docs/despliegue.md, paso 5c.
# Token de acceso de un usuario del sistema de Meta (WhatsApp Business) e id del número que envía:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla de autenticación aprobada, idioma y versión de la Graph API (estos tienen valor por defecto)
WHATSAPP_PLANTILLA=codigo_verificacion
WHATSAPP_IDIOMA=es_MX
WHATSAPP_API_VERSION=v23.0
