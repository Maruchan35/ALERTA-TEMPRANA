# ALERTA CERCA · puente de WhatsApp. Copia este archivo como .env (está en .gitignore) y llénalo.

# Los mismos datos que usa la app (Supabase → Project Settings → API Keys)
SUPABASE_URL=https://TU_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# El mismo valor que guardaste en Vault como 'secreto_puente' (64 caracteres al azar).
# En PowerShell:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SECRETO_PUENTE=

# Opcional: número del WhatsApp que enviará los códigos (con lada, p. ej. 527551234567). Si lo pones,
# en lugar del QR aparece un código de 8 letras para "Vincular con el número de teléfono".
WHATSAPP_NUMERO=

# Al conectarse, la verificación pasa sola a modo "puente". Pon "no" para cambiarlo a mano.
ACTIVAR_AL_CONECTAR=si
